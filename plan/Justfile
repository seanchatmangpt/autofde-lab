default:
    @just --list

bootstrap:
    bash scripts/bootstrap.sh

ontology:
    python3 scripts/pddl_to_ttl.py spec/servengine_ideal_domain.pddl ontology/servengine.ttl
    uv run --quiet --with rdflib --with pyshacl python scripts/validate_ttl.py ontology/servengine.ttl

receipts-lint:
    python3 scripts/receipts_lint.py receipts

# Aggregate gate: runs each lane's gate recipe (gate-* / *-gate) that exists.
check:
    python3 scripts/check.py
