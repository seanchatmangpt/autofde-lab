## Work-order state machine
:WorkOrderState a owl:Class .
:Transition a owl:Class .
:fromState a owl:ObjectProperty ; rdfs:domain :Transition ; rdfs:range :WorkOrderState .
:toState a owl:ObjectProperty ; rdfs:domain :Transition ; rdfs:range :WorkOrderState .
:viaAction a owl:DatatypeProperty ; rdfs:domain :Transition ; rdfs:range xsd:string .
:wo_state_closed a :WorkOrderState ; rdfs:label "closed" .
:wo_state_dispatched a :WorkOrderState ; rdfs:label "dispatched" .
:wo_state_intake a :WorkOrderState ; rdfs:label "intake" .
:wo_state_invoiced a :WorkOrderState ; rdfs:label "invoiced" .
:wo_state_on_site a :WorkOrderState ; rdfs:label "on-site" .
:wo_state_proposal_pending a :WorkOrderState ; rdfs:label "proposal-pending" .
:wo_state_qa_review a :WorkOrderState ; rdfs:label "qa-review" .
:wo_state_ready_to_invoice a :WorkOrderState ; rdfs:label "ready-to-invoice" .
:wo_state_triaged a :WorkOrderState ; rdfs:label "triaged" .
:tr_auto_dispatch_aligned_provider_wo_state_triaged_wo_state_dispatched a :Transition ; :viaAction "auto-dispatch-aligned-provider" ; :fromState :wo_state_triaged ; :toState :wo_state_dispatched .
:tr_emit_and_deliver_client_invoice_wo_state_ready_to_invoice_wo_state_invoiced a :Transition ; :viaAction "emit-and-deliver-client-invoice" ; :fromState :wo_state_ready_to_invoice ; :toState :wo_state_invoiced .
:tr_execute_site_visit_wo_state_dispatched_wo_state_qa_review a :Transition ; :viaAction "execute-site-visit" ; :fromState :wo_state_dispatched ; :toState :wo_state_qa_review .
:tr_hold_linked_wo_for_parent_wo_state_triaged_wo_state_proposal_pending a :Transition ; :viaAction "hold-linked-wo-for-parent" ; :fromState :wo_state_triaged ; :toState :wo_state_proposal_pending .
:tr_reactive_hire_handoff_wo_state_triaged_wo_state_closed a :Transition ; :viaAction "reactive-hire-handoff" ; :fromState :wo_state_triaged ; :toState :wo_state_closed .
:tr_release_linked_wo_after_parent_wo_state_closed_wo_state_triaged a :Transition ; :viaAction "release-linked-wo-after-parent" ; :fromState :wo_state_closed ; :toState :wo_state_triaged .
:tr_release_linked_wo_after_parent_wo_state_proposal_pending_wo_state_triaged a :Transition ; :viaAction "release-linked-wo-after-parent" ; :fromState :wo_state_proposal_pending ; :toState :wo_state_triaged .
:tr_run_ai_vision_closeout_gate_wo_state_qa_review_wo_state_ready_to_invoice a :Transition ; :viaAction "run-ai-vision-closeout-gate" ; :fromState :wo_state_qa_review ; :toState :wo_state_ready_to_invoice .
:tr_run_ai_vision_closeout_gate_no_part_wo_state_qa_review_wo_state_ready_to_invoice a :Transition ; :viaAction "run-ai-vision-closeout-gate-no-part" ; :fromState :wo_state_qa_review ; :toState :wo_state_ready_to_invoice .
:tr_settle_provider_ap_payout_wo_state_invoiced_wo_state_closed a :Transition ; :viaAction "settle-provider-ap-payout" ; :fromState :wo_state_invoiced ; :toState :wo_state_closed .
:tr_settle_provider_ap_payout_quoted_wo_state_invoiced_wo_state_closed a :Transition ; :viaAction "settle-provider-ap-payout-quoted" ; :fromState :wo_state_invoiced ; :toState :wo_state_closed .
:tr_triage_and_route_work_order_wo_state_intake_wo_state_triaged a :Transition ; :viaAction "triage-and-route-work-order" ; :fromState :wo_state_intake ; :toState :wo_state_triaged .
