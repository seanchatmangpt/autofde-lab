@prefix wd:      <urn:wd-fa:> .
@prefix sp:      <http://seanchatmangpt.github.io/packs/shacl-projection#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix sf:      <https://ggen.dev/ontology/semantic-fullstack#> .

wd:TriageRequestShape a sh:NodeShape ;
    sh:property [
        sh:path wd:case_name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:in ( "known_a" "known_b_misleading" "incomplete_a" "novel_x" "novel_x_replay" ) ;
        sh:description "Bounded synthetic failure case key" ;
        sp:isPrimaryOutput true
    ] .

wd:HypothesisResponseShape a sh:NodeShape ;
    sp:projectionName "HypothesisResponseGenerated" ;
    sh:property [
        sh:path wd:mode_id ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sp:isPrimaryOutput true
    ], [
        sh:path wd:candidate_score ;
        sh:datatype xsd:double ;
        sh:minCount 1 ;
        sp:isPrimaryOutput true
    ], [
        sh:path wd:score_basis ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:in ( "TPOT_CANDIDATE_SCORE" "STRUCTURAL_SIMILARITY" ) ;
        sp:isPrimaryOutput true
    ], [
        sh:path wd:structural_similarity ;
        sh:datatype xsd:double ;
        sh:minCount 1 ;
        sp:isPrimaryOutput true
    ], [
        sh:path wd:deterministic_match ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sp:isPrimaryOutput true
    ], [
        sh:path wd:evidence_completeness ;
        sh:datatype xsd:double ;
        sh:minCount 1 ;
        sp:isPrimaryOutput true
    ], [
        sh:path wd:prior_case_ids ;
        sh:datatype xsd:string ;
        sp:collection true ;
        sp:isPrimaryOutput true
    ], [
        sh:path wd:evidence_ids ;
        sh:datatype xsd:string ;
        sp:collection true ;
        sp:isPrimaryOutput true
    ], [
        sh:path wd:owning_team ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sp:isPrimaryOutput true
    ], [
        sh:path wd:action_type ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sp:isPrimaryOutput true
    ], [
        sh:path wd:next_action ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sp:isPrimaryOutput true
    ] .

wd:EvidenceReferenceShape a sh:NodeShape ;
    sp:projectionName "EvidenceReferenceGenerated" ;
    sh:property [
        sh:path wd:evidence_id ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sp:isPrimaryOutput true
    ], [
        sh:path wd:kind ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sp:isPrimaryOutput true
    ], [
        sh:path wd:modality ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sp:isPrimaryOutput true
    ], [
        sh:path wd:source_ref ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sp:isPrimaryOutput true
    ], [
        sh:path wd:digest ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sp:isPrimaryOutput true
    ] .

wd:TriageResponseShape a sh:NodeShape ;
    sh:property [
        sh:path wd:case_id ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:description "Failure case identifier" ;
        sp:isPrimaryOutput true
    ], [
        sh:path wd:standing ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:in ( "UNKNOWN" "PARTIAL_ALIVE" "ALIVE" "BLOCKED" "REFUSED" ) ;
        sh:description "Evidence bounded standing" ;
        sp:isPrimaryOutput true
    ], [
        sh:path wd:admitted_mode ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:description "Deterministically admitted failure mode when present" ;
        sp:nullable true ;
        sp:isPrimaryOutput true
    ], [
        sh:path wd:ranked_hypotheses ;
        sh:node wd:HypothesisResponseShape ;
        sp:collection true ;
        sh:description "Ranked candidate hypotheses; ranking is not admission authority" ;
        sp:isPrimaryOutput true
    ], [
        sh:path wd:closest_prior_cases ;
        sh:datatype xsd:string ;
        sp:collection true ;
        sh:description "Closest admitted prior failure-analysis case identities" ;
        sp:isPrimaryOutput true
    ], [
        sh:path wd:supporting_evidence ;
        sh:node wd:EvidenceReferenceShape ;
        sp:collection true ;
        sh:description "Source-bound evidence references" ;
        sp:isPrimaryOutput true
    ], [
        sh:path wd:next_action ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:description "Bounded next analytical action" ;
        sp:isPrimaryOutput true
    ], [
        sh:path wd:action_type ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:description "TEST, TEARDOWN, ANALYZE, PROCEDURE, or ESCALATE" ;
        sp:isPrimaryOutput true
    ], [
        sh:path wd:owning_team ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:description "Bounded owning-team route" ;
        sp:isPrimaryOutput true
    ], [
        sh:path wd:evidence_completeness ;
        sh:datatype xsd:double ;
        sh:minCount 1 ;
        sh:description "Deterministic required-evidence completeness" ;
        sp:isPrimaryOutput true
    ], [
        sh:path wd:confidence_basis ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:description "Evidence/admission basis, not a free-form model probability" ;
        sp:isPrimaryOutput true
    ], [
        sh:path wd:human_gate ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:in ( "ENGINEER_DISPOSITION_REQUIRED" ) ;
        sh:description "Consequential disposition remains with the FA engineer" ;
        sp:isPrimaryOutput true
    ], [
        sh:path wd:trace_id ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:description "Digest binding the returned candidate triage payload" ;
        sp:isPrimaryOutput true
    ], [
        sh:path wd:authority ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:in ( "SELECT_ONLY" ) ;
        sh:description "Authority ceiling for this surface" ;
        sp:isPrimaryOutput true
    ] .

wd:GroundedTriageDetailShape a sh:NodeShape ;
    rdfs:comment "Legacy flattened grounded-triage view retained for trace compatibility. Rich ranked hypotheses and evidence are now projected through nested SHACL shapes above." ;
    sh:property [
        sh:path wd:candidate_mode ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:description "Ranked candidate failure mode; candidate ranking is not admission"
    ], [
        sh:path wd:closest_prior_case ;
        sh:datatype xsd:string ;
        sh:description "Prior FA case identity associated with a ranked candidate"
    ], [
        sh:path wd:supporting_evidence_id ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:description "Evidence identifier bound to the recommendation"
    ], [
        sh:path wd:evidence_source_ref ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:description "Traceable source locator for normalized evidence"
    ], [
        sh:path wd:evidence_modality ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:description "Normalized evidence modality such as plot or structured test result"
    ], [
        sh:path wd:owning_team ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:description "Bounded routing target for the recommended next analytical action"
    ], [
        sh:path wd:action_type ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:description "TEST, TEARDOWN, ANALYZE, PROCEDURE, or ESCALATE"
    ], [
        sh:path wd:confidence_basis ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:description "Human-readable basis of the confidence signal; not a free-form LLM probability"
    ], [
        sh:path wd:human_gate ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:in ( "ENGINEER_DISPOSITION_REQUIRED" ) ;
        sh:description "Consequential disposition remains with the FA engineer"
    ], [
        sh:path wd:trace_id ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:description "Digest binding the returned candidate triage payload"
    ] .

wd:TriageRequestPydantic a sp:PydanticModel ;
    sp:derivedFromShape wd:TriageRequestShape ;
    sp:className "TriageRequestGenerated" ;
    dcterms:description "Generated request contract for bounded WD failure analysis" .

wd:TriageResponsePydantic a sp:PydanticModel ;
    sp:derivedFromShape wd:TriageResponseShape ;
    sp:className "TriageResponseGenerated" ;
    dcterms:description "Generated scalar response envelope for bounded WD failure analysis" .

wd:TriageRequestZod a sp:ZodSchema ;
    sp:derivedFromShape wd:TriageRequestShape ;
    sp:schemaName "TriageRequestGeneratedSchema" .

wd:TriageResponseZod a sp:ZodSchema ;
    sp:derivedFromShape wd:TriageResponseShape ;
    sp:schemaName "TriageResponseGeneratedSchema" .


# DfCM full-stack projection profile.
# The same canonical graph that manufactures the scalar Pydantic/Zod contract
# also supplies the deterministic FastAPI/Next.js reference projection.
# These are bounded repository-local fixture states, not WD production facts.

wd:CaseStudy2Application a sf:Application ;
    sf:appName "WD Semantic Failure Analysis — Generated Projection" ;
    sf:pageTitle "WD Case Study 2 — Semantic Failure Analysis" ;
    sf:apiBasePath "/api" ;
    sf:defaultScenario "known_a" ;
    sf:runtimeIntelligence "NONE" ;
    sf:manufactureMode "DETERMINISTIC" .

wd:KnownAScenario a sf:Scenario ;
    sf:scenarioId "known_a" ;
    sf:title "Known firmware failure" ;
    sf:classification "KNOWN" ;
    sf:standing "ALIVE" ;
    sf:candidateMode "MODE-A-FIRMWARE" ;
    sf:admittedMode "MODE-A-FIRMWARE" ;
    sf:confidenceBasis "DETERMINISTIC_RULE_AND_REQUIRED_EVIDENCE" ;
    sf:nextAction "run_firmware_regression" ;
    sf:owningTeam "firmware_analysis" ;
    sf:humanGate "ENGINEER_DISPOSITION_REQUIRED" ;
    sf:authority "SELECT_CONSTRUCT_ONLY" ;
    sf:evidenceCsv "KNOWN-A:test|KNOWN-A:waveform" ;
    sf:missingEvidenceCsv "" ;
    sf:priorCasesCsv "SYNTH-FA-A-001|SYNTH-FA-A-002" ;
    sf:exposed true ;
    sf:order 1 .

wd:KnownBMisleadingScenario a sf:Scenario ;
    sf:scenarioId "known_b_misleading" ;
    sf:title "Known supplier failure despite misleading similarity" ;
    sf:classification "KNOWN" ;
    sf:standing "ALIVE" ;
    sf:candidateMode "MODE-B-SUPPLIER" ;
    sf:admittedMode "MODE-B-SUPPLIER" ;
    sf:confidenceBasis "DETERMINISTIC_RULE_AND_REQUIRED_EVIDENCE" ;
    sf:nextAction "inspect_supplier_lot" ;
    sf:owningTeam "supplier_quality" ;
    sf:humanGate "ENGINEER_DISPOSITION_REQUIRED" ;
    sf:authority "SELECT_CONSTRUCT_ONLY" ;
    sf:evidenceCsv "KNOWN-B:test|KNOWN-B:lot_trace" ;
    sf:missingEvidenceCsv "" ;
    sf:priorCasesCsv "SYNTH-FA-B-001" ;
    sf:exposed true ;
    sf:order 2 .

wd:IncompleteAScenario a sf:Scenario ;
    sf:scenarioId "incomplete_a" ;
    sf:title "Applicable firmware prior with incomplete evidence" ;
    sf:classification "PARTIAL" ;
    sf:standing "PARTIAL_ALIVE" ;
    sf:candidateMode "MODE-A-FIRMWARE" ;
    sf:admittedMode "NONE" ;
    sf:confidenceBasis "DETERMINISTIC_RULE_INCOMPLETE_EVIDENCE" ;
    sf:nextAction "run_firmware_regression" ;
    sf:owningTeam "firmware_analysis" ;
    sf:humanGate "ENGINEER_DISPOSITION_REQUIRED" ;
    sf:authority "SELECT_CONSTRUCT_ONLY" ;
    sf:evidenceCsv "PARTIAL-A:test" ;
    sf:missingEvidenceCsv "waveform" ;
    sf:priorCasesCsv "SYNTH-FA-A-001|SYNTH-FA-A-002" ;
    sf:exposed true ;
    sf:order 3 .

wd:NovelXScenario a sf:Scenario ;
    sf:scenarioId "novel_x" ;
    sf:title "Novel failure signature" ;
    sf:classification "UNKNOWN" ;
    sf:standing "UNKNOWN" ;
    sf:candidateMode "MODE-X-CANDIDATE" ;
    sf:admittedMode "NONE" ;
    sf:confidenceBasis "NO_RULE_ADMISSION_CANDIDATE_RANKING_NON_AUTHORITATIVE" ;
    sf:nextAction "open_novel_failure_investigation" ;
    sf:owningTeam "failure_analysis" ;
    sf:humanGate "ENGINEER_DISPOSITION_REQUIRED" ;
    sf:authority "SELECT_CONSTRUCT_ONLY" ;
    sf:evidenceCsv "NOVEL-X:test|NOVEL-X:waveform|NOVEL-X:lot_trace" ;
    sf:missingEvidenceCsv "" ;
    sf:priorCasesCsv "" ;
    sf:exposed true ;
    sf:order 4 .

wd:NovelXVerifiedScenario a sf:Scenario ;
    sf:scenarioId "novel_x_verified" ;
    sf:title "Novel failure after independently verified disposition" ;
    sf:classification "KNOWN" ;
    sf:standing "ALIVE" ;
    sf:candidateMode "MODE-X-NOVEL" ;
    sf:admittedMode "MODE-X-NOVEL" ;
    sf:confidenceBasis "DETERMINISTIC_RULE_AND_REQUIRED_EVIDENCE" ;
    sf:nextAction "repeat_verified_novel_x_procedure" ;
    sf:owningTeam "failure_analysis" ;
    sf:humanGate "ENGINEER_DISPOSITION_REQUIRED" ;
    sf:authority "SELECT_CONSTRUCT_ONLY" ;
    sf:evidenceCsv "NOVEL-X-REPLAY:test|NOVEL-X-REPLAY:waveform|NOVEL-X-REPLAY:lot_trace" ;
    sf:missingEvidenceCsv "" ;
    sf:priorCasesCsv "NOVEL-X" ;
    sf:exposed false ;
    sf:order 5 .

wd:AdmitNovelXExperience a sf:Transition ;
    sf:transitionId "admit_verified_machine_experience" ;
    sf:fromScenario "novel_x" ;
    sf:toScenario "novel_x_verified" ;
    sf:triggerLabel "Admit independently verified MachineExperience" .


wd:HypothesisResponsePydantic a sp:PydanticModel ;
    sp:derivedFromShape wd:HypothesisResponseShape ;
    sp:className "HypothesisResponseGenerated" ;
    dcterms:description "Generated ranked hypothesis contract; candidate ranking is non-authoritative" .

wd:EvidenceReferencePydantic a sp:PydanticModel ;
    sp:derivedFromShape wd:EvidenceReferenceShape ;
    sp:className "EvidenceReferenceGenerated" ;
    dcterms:description "Generated source-bound evidence reference contract" .

wd:HypothesisResponseZod a sp:ZodSchema ;
    sp:derivedFromShape wd:HypothesisResponseShape ;
    sp:schemaName "HypothesisResponseGenerated" .

wd:EvidenceReferenceZod a sp:ZodSchema ;
    sp:derivedFromShape wd:EvidenceReferenceShape ;
    sp:schemaName "EvidenceReferenceGenerated" .
