{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seanchatman.dev/schemas/chatman-clean-session-receipt.schema.json",
  "title": "Chatman Clean-Session Execution Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "task_identity",
    "standing",
    "state_digest",
    "broker_receipts",
    "actions",
    "replay_of"
  ],
  "properties": {
    "receipt_id": {"$ref": "#/$defs/digest"},
    "task_identity": {"$ref": "#/$defs/digest"},
    "standing": {"$ref": "#/$defs/standing"},
    "state_digest": {"$ref": "#/$defs/digest"},
    "broker_receipts": {
      "type": "array",
      "items": {"$ref": "#/$defs/brokerReceipt"}
    },
    "actions": {
      "type": "array",
      "items": {"$ref": "#/$defs/action"}
    },
    "replay_of": {
      "anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "standing": {
      "anyOf": [
        {
          "enum": [
            "UNKNOWN",
            "PARTIAL_ALIVE",
            "ALIVE",
            "BLOCKED",
            "BUILD_BROKEN",
            "UNSUPPORTED"
          ]
        },
        {"type": "string", "pattern": "^REFUSED:.+$"}
      ]
    },
    "brokerReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "intent_id",
        "standing",
        "consequence",
        "reason"
      ],
      "properties": {
        "receipt_id": {"$ref": "#/$defs/digest"},
        "intent_id": {"$ref": "#/$defs/digest"},
        "standing": {"$ref": "#/$defs/standing"},
        "consequence": {"type": "object"},
        "reason": {"type": ["string", "null"]}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "lane", "route"],
      "properties": {
        "kind": {
          "enum": [
            "parse",
            "try_route",
            "classify_exhaustion",
            "admit",
            "diagnose_or_repair",
            "construct",
            "actuate",
            "observe_consequence",
            "verify",
            "receipt",
            "replay_or_hook"
          ]
        },
        "lane": {"enum": ["SELECT", "CONSTRUCT", "DO"]},
        "route": {"type": ["string", "null"]}
      }
    }
  }
}
