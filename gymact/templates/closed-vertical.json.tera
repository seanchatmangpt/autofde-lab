{# GENERATED by ggen from ontology/closed-vertical.ttl. #}
{%- set steps = sparql(query='PREFIX ga: <https://github.com/seanchatmangpt/autofde-lab/ns/gymact#> PREFIX pplan: <http://purl.org/net/p-plan#> SELECT ?id ?activity ?ordinal WHERE { <https://github.com/seanchatmangpt/autofde-lab/data/gymact/azure-closed-vertical> ga:hasProcessStep ?step . ?step a pplan:Step ; ga:activityCode ?activity ; ga:ordinal ?ordinal . BIND(REPLACE(STR(?step), "^.*/", "") AS ?id) } ORDER BY ?ordinal') -%}
{
  "schema": "autofde.capability-bundle.v1",
  "name": "{{ rows[0].slug }}",
  "interaction_model": "{{ rows[0].model }}",
  "process_schema": "{{ rows[0].processSchema }}",
  "authority": {
    "mode": "{{ rows[0].authorityMode }}",
    "scope": "named-test-subscription",
    "consequences": ["azure:terraform-apply", "azure:terraform-destroy"]
  },
  "evidence": {
    "format": "OCEL 2.0 JSON",
    "independent_postcondition": true,
    "orphan_sweep": true,
    "replay": true
  },
  "process": [
{% for step in steps -%}
    {
      "id": "{{ step.id }}",
      "activity": "{{ step.activity }}",
      "predecessors": [{% if step.id != "p01" %}"p{{ "%02d" | format((step.ordinal / 10) - 1) }}"{% endif %}],
      "required_object_types": [{% if step.id == "p01" %}"Incident", "AzureSubscription"{% elif step.id == "p02" %}"Incident", "CapabilityBundle"{% elif step.id == "p03" %}"Incident", "AgentSession", "CapabilityBundle"{% elif step.id == "p04" %}"AgentSession", "AzureSubscription"{% elif step.id == "p05" %}"AgentSession", "CapabilityBundle", "TerraformResource"{% elif step.id == "p06" %}"AuthorityEnvelope", "AzureSubscription", "CapabilityBundle"{% elif step.id == "p07" or step.id == "p09" %}"AuthorityEnvelope", "CapabilityBundle", "AzureSubscription", "TerraformResource"{% elif step.id == "p08" or step.id == "p10" or step.id == "p11" %}"AzureSubscription", "TerraformResource"{% else %}"CapabilityBundle", "AgentSession", "AuthorityEnvelope", "AzureSubscription", "TerraformResource"{% endif %}]
    }{% if not loop.last %},{% endif %}
{% endfor -%}
  ]
}
