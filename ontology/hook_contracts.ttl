@prefix hc:   <urn:autofde-lab:hook-contract:> .
@prefix afl:  <urn:autofde-lab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# Abstract hook contracts hand-written in autofde-lab builders/domain and
# builders/solver. Each hc:Hook is a method whose body raises
# HookNotImplementedError (typed) or bare NotImplementedError (bare), lifted
# mechanically from the AST by scripts-of-record (extract.py, scratch) and then
# authored here. hc:skipReason is non-empty only when the owning class cannot
# be instantiated generically; the ggen court fails LOUDLY for those.

<urn:autofde-lab:pack:hook-contracts> a hc:Registry ;
    dct:title "AutoFDE Lab abstract hook contracts" .

hc:Constrained._get_constraints_ a hc:Hook ;
