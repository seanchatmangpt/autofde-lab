# ---- SHACL shapes (copied verbatim from shapes/hook.shacl.ttl) ----
@prefix hc:  <urn:autofde-lab:hook-contract:> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:autofde-lab:shape:hook-contract>
    a sh:NodeShape ;
    sh:targetClass hc:Hook ;
    sh:property [ sh:path hc:module ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:message "A hook must name exactly one owning module." ] ;
    sh:property [ sh:path hc:className ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:message "A hook must name exactly one owning class." ] ;
    sh:property [ sh:path hc:hookName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:message "A hook must name exactly one method." ] ;
    sh:property [ sh:path hc:raises ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "typed" "bare" ) ;
        sh:message "hc:raises must be typed (HookNotImplementedError) or bare (NotImplementedError)." ] ;
    sh:property [ sh:path hc:requiredArgs ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ;
        sh:message "A hook must declare its required positional arg count." ] ;
    sh:property [ sh:path hc:skipReason ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:message "skipReason is mandatory (empty string = instantiable); skipping must be explicit." ] .
