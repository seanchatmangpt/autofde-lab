    hc:className "Constrained" ;
    hc:hookName "_get_constraints_" ;
    hc:raises "bare" ;
    hc:requiredArgs "0"^^xsd:integer ;
    hc:requiredKwOnly "" ;
    hc:signature "self" ;
    hc:contract "Get the domain constraints." ;
    hc:skipReason "" .

