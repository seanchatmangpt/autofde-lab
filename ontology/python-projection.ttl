# standing
afl:StandingValue afl:pythonModule "standing" ; afl:pythonOrder 10 .
afl:StandingAssertion afl:pythonModule "standing" ; afl:pythonOrder 20 .
afl:Refusal afl:pythonModule "standing" ; afl:pythonOrder 30 .

# interop
afl:InteropContract afl:pythonModule "interop" ; afl:pythonOrder 10 .
afl:InteropAdapter afl:pythonModule "interop" ; afl:pythonOrder 20 .
afl:ExternalRepresentation afl:pythonModule "interop" ; afl:pythonOrder 30 .
afl:Projection afl:pythonModule "interop" ; afl:pythonOrder 40 .
afl:SemanticLoss afl:pythonModule "interop" ; afl:pythonOrder 50 .
afl:LossReport afl:pythonModule "interop" ; afl:pythonOrder 60 .
afl:InteropContractReceipt afl:pythonModule "interop" ; afl:pythonOrder 70 .

# manufacture
afl:SemanticConstitution afl:pythonModule "manufacture" ; afl:pythonOrder 10 .
afl:ManufactureRule afl:pythonModule "manufacture" ; afl:pythonOrder 20 .
