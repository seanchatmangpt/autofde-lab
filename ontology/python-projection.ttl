@prefix afl: <urn:autofde-lab:> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:autofde-lab:ontology:python-projection>
    a owl:Ontology ;
    dcterms:title "AutoFDE Lab ggen Python projection" ;
    dcterms:description "Language projection metadata only. The semantic constitution remains the authority; this graph assigns canonical Python modules and deterministic generation order." ;
    dcterms:created "2026-08-08"^^xsd:date .

afl:pythonModule
    a owl:DatatypeProperty ;
    rdfs:label "Python module" .

afl:pythonOrder
    a owl:DatatypeProperty ;
    rdfs:label "Python generation order" .

afl:ggenPythonProjection
    a afl:ManufactureRule ;
    dcterms:title "ggen Python semantic projection" .

# lab
afl:Gym afl:pythonModule "lab" ; afl:pythonOrder 10 .
afl:Trial afl:pythonModule "lab" ; afl:pythonOrder 20 .
afl:Experiment afl:pythonModule "lab" ; afl:pythonOrder 30 .
afl:Goal afl:pythonModule "lab" ; afl:pythonOrder 40 .
afl:Invariant afl:pythonModule "lab" ; afl:pythonOrder 50 .
afl:Resource afl:pythonModule "lab" ; afl:pythonOrder 60 .
afl:Capability afl:pythonModule "lab" ; afl:pythonOrder 70 .
afl:Perturbation afl:pythonModule "lab" ; afl:pythonOrder 80 .

# world
afl:World afl:pythonModule "world" ; afl:pythonOrder 10 .
afl:WorldState afl:pythonModule "world" ; afl:pythonOrder 20 .
afl:Environment afl:pythonModule "world" ; afl:pythonOrder 30 .
afl:Observation afl:pythonModule "world" ; afl:pythonOrder 40 .
afl:AdmittedObservation afl:pythonModule "world" ; afl:pythonOrder 50 .
afl:ObservationAdmission afl:pythonModule "world" ; afl:pythonOrder 60 .

# planning
