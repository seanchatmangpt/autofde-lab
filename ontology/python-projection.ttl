afl:Validation afl:pythonModule "planning" ; afl:pythonOrder 70 .
afl:GovernedCandidate afl:pythonModule "planning" ; afl:pythonOrder 80 .
afl:Disagreement afl:pythonModule "planning" ; afl:pythonOrder 90 .
afl:DiscriminatingProbe afl:pythonModule "planning" ; afl:pythonOrder 100 .

# process
afl:POWLProcess afl:pythonModule "process" ; afl:pythonOrder 10 .
afl:ProcessNode afl:pythonModule "process" ; afl:pythonOrder 20 .
afl:TransitionNode afl:pythonModule "process" ; afl:pythonOrder 30 .
afl:SilentTransition afl:pythonModule "process" ; afl:pythonOrder 40 .
afl:PartialOrderComposite afl:pythonModule "process" ; afl:pythonOrder 50 .
afl:ChoiceGraph afl:pythonModule "process" ; afl:pythonOrder 60 .
afl:OrderEdge afl:pythonModule "process" ; afl:pythonOrder 70 .
afl:POWLCommitment afl:pythonModule "process" ; afl:pythonOrder 80 .

# authority
afl:AuthorityEnvelope afl:pythonModule "authority" ; afl:pythonOrder 10 .
afl:Actuation afl:pythonModule "authority" ; afl:pythonOrder 20 .

# evidence
afl:Postcondition afl:pythonModule "evidence" ; afl:pythonOrder 10 .
afl:Observer afl:pythonModule "evidence" ; afl:pythonOrder 20 .
afl:PostconditionObservation afl:pythonModule "evidence" ; afl:pythonOrder 30 .
afl:Receipt afl:pythonModule "evidence" ; afl:pythonOrder 40 .
afl:ReceiptDAG afl:pythonModule "evidence" ; afl:pythonOrder 50 .
afl:Replay afl:pythonModule "evidence" ; afl:pythonOrder 60 .
afl:Artifact afl:pythonModule "evidence" ; afl:pythonOrder 70 .
afl:ArtifactManifest afl:pythonModule "evidence" ; afl:pythonOrder 80 .
afl:SourceRevision afl:pythonModule "evidence" ; afl:pythonOrder 90 .
