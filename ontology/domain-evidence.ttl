@prefix afl: <urn:autofde-lab:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Domain-evidence-generation ontology: real facts about each hub domain
# needed to generate a generic OCEL episode runner + standalone verifier
# registry entry, per docs/jira/2026-08-13-domain-maturity-l4/
# INDEX-AND-GGEN-DESIGN.md's "autofde-domain-evidence-pack" design.
#
# Only ONE domain individual is admitted here so far: afl:domain_terragoat
# (the L4 push's pilot, per the same doc -- terragoat already scores >=4 on
# 5/7 maturity dimensions, so this closes the real remaining gap for real,
# rather than adding untested breadth). Adding the other 21 domains is
# future work -- each addition is one new individual, zero template changes,
# the same "generic template, growing ontology" pattern already proven this
# session (public-ontology-admission-pack's SKOS add).

afl:DomainEvidenceSpec a rdfs:Class ;
    rdfs:comment "One hub domain's facts needed to generate a generic OCEL episode runner + standalone verifier registry entry." .

afl:Capability a rdfs:Class ;
    rdfs:comment "One DO/OBSERVE capability of a domain, with its precondition expression." .

afl:domainName a rdf:Property ; rdfs:domain afl:DomainEvidenceSpec ; rdfs:range xsd:string .
afl:pythonModulePath a rdf:Property ; rdfs:domain afl:DomainEvidenceSpec ; rdfs:range xsd:string .
afl:domainClassName a rdf:Property ; rdfs:domain afl:DomainEvidenceSpec ; rdfs:range xsd:string .
afl:bridgeModulePath a rdf:Property ; rdfs:domain afl:DomainEvidenceSpec ; rdfs:range xsd:string .
afl:bridgeClassName a rdf:Property ; rdfs:domain afl:DomainEvidenceSpec ; rdfs:range xsd:string .
afl:goalCheckExpr a rdf:Property ; rdfs:domain afl:DomainEvidenceSpec ; rdfs:range xsd:string .
afl:verifyMode a rdf:Property ; rdfs:domain afl:DomainEvidenceSpec ; rdfs:range xsd:string .
afl:evidenceOutPath a rdf:Property ; rdfs:domain afl:DomainEvidenceSpec ; rdfs:range xsd:string .
afl:hasCapability a rdf:Property ; rdfs:domain afl:DomainEvidenceSpec ; rdfs:range afl:Capability .
afl:capabilityOrder a rdf:Property ; rdfs:domain afl:Capability ; rdfs:range xsd:integer .
afl:capabilityName a rdf:Property ; rdfs:domain afl:Capability ; rdfs:range xsd:string .
afl:capabilityConsequence a rdf:Property ; rdfs:domain afl:Capability ; rdfs:range xsd:string .
afl:capabilityPrecondition a rdf:Property ; rdfs:domain afl:Capability ; rdfs:range xsd:string .

# --- Pilot domain: terragoat ---
# Real source verified this session: src/autofde_lab/hub/domain/terragoat/
# terragoat_remediation.py -- TerraGoatRemediation, real-time parse of
# vendored .tf files, real Astar-solved plan (5/5), no gymact_bridge.py yet
# (AFL-TERRAGOAT-1, ticketed, not yet built -- bridgeClassName left "" here,
# honestly reflecting that gap rather than inventing a bridge that doesn't
# exist). verifyMode is "fresh-instance-replay": a fresh TerraGoatRemediation
# instance is constructed and the recorded finding-closure sequence replayed
# against it, independent of the actor's own in-process object, per
# terragoat's already-real verification-independence pattern
# (tests/ecosystem/test_gymact_terragoat_bridge_chicago.py).

afl:domain_terragoat a afl:DomainEvidenceSpec ;
    afl:domainName "terragoat" ;
    afl:pythonModulePath "autofde_lab.hub.domain.terragoat.terragoat_remediation" ;
    afl:domainClassName "TerraGoatRemediation" ;
    afl:bridgeModulePath "" ;
    afl:bridgeClassName "" ;
    afl:goalCheckExpr "len(state.open_findings) == 0" ;
    afl:verifyMode "fresh-instance-replay" ;
    afl:evidenceOutPath "docs/evidence/terragoat/domain-evidence-episode.ocel.json" ;
    afl:hasCapability afl:domain_terragoat_cap_close_finding .

afl:domain_terragoat_cap_close_finding a afl:Capability ;
    afl:capabilityOrder 1 ;
    afl:capabilityName "close_finding" ;
    afl:capabilityConsequence "DO" ;
    afl:capabilityPrecondition "finding_id in state.open_findings" .


# --- 8 more domains, real Astar-reaches-goal proofs grounded via ultracode fan-out ---

afl:domain_breach_clock a afl:DomainEvidenceSpec ;
    afl:domainName "breach_clock" ;
    afl:pythonModulePath "autofde_lab.hub.domain.breach_clock.breach_clock" ;
    afl:domainClassName "BreachClockDomain" ;
    afl:bridgeModulePath "" ;
    afl:bridgeClassName "" ;
    afl:goalCheckExpr "state.notification is Notification.DELIVERED and state.notified_populations == state.populations" ;
    afl:verifyMode "fresh-instance-replay" ;
    afl:evidenceOutPath "docs/evidence/breach_clock/domain-evidence-episode.ocel.json" ;
    afl:hasCapability afl:domain_breach_clock_cap_1 .

afl:domain_breach_clock_cap_1 a afl:Capability ;
    afl:capabilityOrder 1 ;
    afl:capabilityName "deliver_notification" ;
    afl:capabilityConsequence "DO" ;
    afl:capabilityPrecondition "state.notification is Notification.DRAFTED and state.notified_populations == state.populations" .

afl:domain_career_admission a afl:DomainEvidenceSpec ;
    afl:domainName "career_admission" ;
    afl:pythonModulePath "autofde_lab.hub.domain.career_admission.career_admission" ;
    afl:domainClassName "CareerAdmission" ;
    afl:bridgeModulePath "" ;
    afl:bridgeClassName "" ;
    afl:goalCheckExpr "self._required_categories.issubset({self._facts[fact_id].category for fact_id in state.admitted if fact_id in self._facts})" ;
    afl:verifyMode "fresh-instance-replay" ;
    afl:evidenceOutPath "docs/evidence/career_admission/domain-evidence-episode.ocel.json" ;
    afl:hasCapability afl:domain_career_admission_cap_1 .

afl:domain_career_admission_cap_1 a afl:Capability ;
    afl:capabilityOrder 1 ;
    afl:capabilityName "intuit_automl" ;
    afl:capabilityConsequence "DO" ;
    afl:capabilityPrecondition "fact.id not in admitted and set(fact.prerequisite_ids).issubset(admitted)" .

afl:domain_up a afl:DomainEvidenceSpec ;
    afl:domainName "up" ;
    afl:pythonModulePath "autofde_lab.hub.domain.up.up" ;
    afl:domainClassName "UPDomain" ;
    afl:bridgeModulePath "" ;
    afl:bridgeClassName "" ;
    afl:goalCheckExpr "self._simulator.is_goal(state.up_state)" ;
    afl:verifyMode "fresh-instance-replay" ;
    afl:evidenceOutPath "docs/evidence/up/domain-evidence-episode.ocel.json" ;
    afl:hasCapability afl:domain_up_cap_1 .

afl:domain_up_cap_1 a afl:Capability ;
    afl:capabilityOrder 1 ;
    afl:capabilityName "SkUPAction" ;
    afl:capabilityConsequence "DO" ;
    afl:capabilityPrecondition "true" .

afl:domain_cloudgoat_iam_privesc a afl:DomainEvidenceSpec ;
    afl:domainName "cloudgoat_iam_privesc" ;
    afl:pythonModulePath "autofde_lab.hub.domain.cloudgoat_iam_privesc.cloudgoat_iam_privesc" ;
    afl:domainClassName "CloudGoatIamPrivescDomain" ;
    afl:bridgeModulePath "" ;
    afl:bridgeClassName "" ;
    afl:goalCheckExpr "state.enumerated and state.admin_role_on_profile and state.keypair_created and state.instance_launched and state.has_shell_access and state.target_terminated" ;
    afl:verifyMode "fresh-instance-replay" ;
    afl:evidenceOutPath "docs/evidence/cloudgoat_iam_privesc/domain-evidence-episode.ocel.json" ;
    afl:hasCapability afl:domain_cloudgoat_iam_privesc_cap_1 .

afl:domain_cloudgoat_iam_privesc_cap_1 a afl:Capability ;
    afl:capabilityOrder 1 ;
    afl:capabilityName "terminate_target_instance" ;
    afl:capabilityConsequence "DO" ;
    afl:capabilityPrecondition "state.has_shell_access and not state.target_terminated" .

afl:domain_fix_git a afl:DomainEvidenceSpec ;
    afl:domainName "fix_git" ;
    afl:pythonModulePath "autofde_lab.hub.domain.fix_git.git_recovery" ;
    afl:domainClassName "GitRecoveryDomain" ;
    afl:bridgeModulePath "" ;
    afl:bridgeClassName "" ;
    afl:goalCheckExpr "state.current_branch == self.base_branch and state.recovery_branch_exists and state.merged" ;
    afl:verifyMode "fresh-instance-replay" ;
    afl:evidenceOutPath "docs/evidence/fix_git/domain-evidence-episode.ocel.json" ;
    afl:hasCapability afl:domain_fix_git_cap_1 .

afl:domain_fix_git_cap_1 a afl:Capability ;
    afl:capabilityOrder 1 ;
    afl:capabilityName "merge_recovery" ;
    afl:capabilityConsequence "DO" ;
    afl:capabilityPrecondition "memory.current_branch == self.base_branch and memory.recovery_branch_exists and not memory.merged" .

afl:domain_k8s_goat_rbac_escalation a afl:DomainEvidenceSpec ;
    afl:domainName "k8s_goat_rbac_escalation" ;
    afl:pythonModulePath "autofde_lab.hub.domain.k8s_goat_rbac_escalation.k8s_goat_rbac_escalation" ;
    afl:domainClassName "K8sGoatRBACEscalation" ;
    afl:bridgeModulePath "" ;
    afl:bridgeClassName "" ;
    afl:goalCheckExpr "GOAL_STEP_ID in state.known" ;
    afl:verifyMode "fresh-instance-replay" ;
    afl:evidenceOutPath "docs/evidence/k8s_goat_rbac_escalation/domain-evidence-episode.ocel.json" ;
    afl:hasCapability afl:domain_k8s_goat_rbac_escalation_cap_1 .

afl:domain_k8s_goat_rbac_escalation_cap_1 a afl:Capability ;
    afl:capabilityOrder 1 ;
    afl:capabilityName "read_and_decode_k8svaultapikey" ;
    afl:capabilityConsequence "DO" ;
    afl:capabilityPrecondition "'list_namespace_secrets' in known" .

afl:domain_maze a afl:DomainEvidenceSpec ;
    afl:domainName "maze" ;
    afl:pythonModulePath "autofde_lab.hub.domain.maze.maze" ;
    afl:domainClassName "Maze" ;
    afl:bridgeModulePath "" ;
    afl:bridgeClassName "" ;
    afl:goalCheckExpr "state == self._goal" ;
    afl:verifyMode "fresh-instance-replay" ;
    afl:evidenceOutPath "docs/evidence/maze/domain-evidence-episode.ocel.json" ;
    afl:hasCapability afl:domain_maze_cap_1 .

afl:domain_maze_cap_1 a afl:Capability ;
    afl:capabilityOrder 1 ;
    afl:capabilityName "up|down|left|right" ;
    afl:capabilityConsequence "DO" ;
    afl:capabilityPrecondition "true" .

afl:domain_pddl a afl:DomainEvidenceSpec ;
    afl:domainName "pddl" ;
    afl:pythonModulePath "autofde_lab.hub.domain.pddl.domain" ;
    afl:domainClassName "PDDLDomain" ;
    afl:bridgeModulePath "" ;
    afl:bridgeClassName "" ;
    afl:goalCheckExpr "self._goal_checker.is_goal(s.to_cpp())  # C++ CppGoalChecker compiled from the loaded PDDL domain/problem file; for the proven fixture (blocks-3-0) the goal is 'on(b, c)'" ;
    afl:verifyMode "fresh-instance-replay" ;
    afl:evidenceOutPath "docs/evidence/pddl/domain-evidence-episode.ocel.json" ;
    afl:hasCapability afl:domain_pddl_cap_1 .

afl:domain_pddl_cap_1 a afl:Capability ;
    afl:capabilityOrder 1 ;
    afl:capabilityName "PDDLAction  # grounded action instance, e.g. (pick-up|stack|...) — dynamically enumerated per problem file, not a fixed constant" ;
    afl:capabilityConsequence "DO" ;
    afl:capabilityPrecondition "self._aops_gen.get_applicable_actions(memory.to_cpp())  # C++ delete-relaxation-free applicability generator over the PDDL task's compiled action schema; no static Python precondition expression exists in this module" .


