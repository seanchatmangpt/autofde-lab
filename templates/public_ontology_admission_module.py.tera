"""PUBLIC-ONLY ADMISSION policy — direct Python projection.

Manufactured by `ggen sync run` from `ontology/public-ontology-admission.ttl`
via `queries/public-ontology-admission/admission.rq`: a class IRI is
admitted only if it belongs to a real, verified public semantic authority
(a resolvable W3C/OMG/OASIS/etc namespace), never a locally-invented
private class. Every authority and class was verified live (WebFetch
against the real specification document) before being transcribed into the
source ontology file — see that file's own grounding note.

Same pack, same generated shape, as `gymact.semantics.admission` (that
repo's copy of this ontology) — not hand-duplicated logic, the same real
facts projected twice.

GENERATED by ggen. DO NOT EDIT BY HAND -- edit
`ontology/public-ontology-admission.ttl` and re-run `ggen sync run` from the
repo root to regenerate.
"""
from __future__ import annotations

from dataclasses import dataclass
from enum import Enum


class SourceKind(str, Enum):
    """Where an admitted class's semantics actually come from -- never silently relabeled."""

    NATIVE_ONTOLOGY = "NATIVE_ONTOLOGY"
    RDF_VOCABULARY = "RDF_VOCABULARY"
    NORMATIVE_METAMODEL = "NORMATIVE_METAMODEL"
    NORMATIVE_SCHEMA = "NORMATIVE_SCHEMA"
    PROTOCOL_SPECIFICATION = "PROTOCOL_SPECIFICATION"
    CONTROL_MODEL = "CONTROL_MODEL"
    PUBLIC_TAXONOMY = "PUBLIC_TAXONOMY"
    VENDOR_RESOURCE_SCHEMA = "VENDOR_RESOURCE_SCHEMA"
    DERIVED_PROJECTION = "DERIVED_PROJECTION"
    LOCAL_INSTANCE = "LOCAL_INSTANCE"


@dataclass(frozen=True)
class PublicAuthority:
    authority_id: str
    namespace_uri: str
    spec_uri: str
    publication_status: str
    source_kind: SourceKind


@dataclass(frozen=True)
class AdmittedClass:
    authority_id: str
    class_name: str
    class_iri: str
    comment: str


{% set authority_rows = sparql_results | filter(attribute="rowKind", value="authority") -%}
{% set class_rows = sparql_results | filter(attribute="rowKind", value="class") -%}
PUBLIC_AUTHORITIES: dict[str, PublicAuthority] = {
{% for row in authority_rows -%}
    "{{ row.authorityId }}": PublicAuthority(
        authority_id="{{ row.authorityId }}",
        namespace_uri="{{ row.namespaceUri }}",
        spec_uri="{{ row.specUri }}",
        publication_status="{{ row.publicationStatus }}",
        source_kind=SourceKind.{{ row.sourceKind }},
    ),
{% endfor -%}
}

ADMITTED_CLASSES: dict[str, AdmittedClass] = {
{% for row in class_rows -%}
    "{{ row.classIri }}": AdmittedClass(
        authority_id="{{ row.belongsToAuthorityId }}",
        class_name="{{ row.className }}",
        class_iri="{{ row.classIri }}",
        comment="{{ row.classComment | replace(from='"', to='\"') | replace(from='\n', to=' ') }}",
    ),
{% endfor -%}
}


def is_admitted(class_iri: str) -> bool:
    """True only if `class_iri` is a real, admitted public-authority class -- never true for
    an invented local class IRI, per the PUBLIC-ONLY ADMISSION policy."""
    return class_iri in ADMITTED_CLASSES


def classify(class_iri: str) -> SourceKind | None:
    """The admitted class's `SourceKind`, or `None` if `class_iri` is not admitted (the
    caller must treat an unadmitted class as `UNSUPPORTED`, never silently invent one)."""
    admitted = ADMITTED_CLASSES.get(class_iri)
    if admitted is None:
        return None
    return PUBLIC_AUTHORITIES[admitted.authority_id].source_kind
