def test_generated_registry_is_total_for_projected_classes() -> None:
    assert len(CLASS_BY_IRI) == {{ sparql_results | length }}
    assert CLASS_BY_IRI["urn:autofde-lab:AdmittedObservation"] is AdmittedObservation
    assert CLASS_BY_IRI["urn:autofde-lab:Level4Witness"] is Level4Witness


def test_generated_subclass_edges_preserve_constitution() -> None:
    assert issubclass(AdmittedObservation, Observation)
    assert issubclass(Level4Witness, EvidenceWitness)
    assert issubclass(TransitionNode, ProcessNode)
    assert issubclass(SilentTransition, TransitionNode)


def test_generated_entity_freezes_supplied_bindings() -> None:
    source = {"urn:autofde-lab:trialId": "trial-1"}
    entity = entity_from_rdf_type(
        "urn:autofde-lab:Trial",
        iri="urn:trial:1",
        values=source,
    )
    source["urn:autofde-lab:trialId"] = "mutated"
    assert isinstance(entity.values, MappingProxyType)
    assert entity.require("urn:autofde-lab:trialId") == "trial-1"


def test_generated_terms_cover_authority_and_standing_boundaries() -> None:
    assert PROPERTY_IRI_BY_NAME["authorizedBy"] == "urn:autofde-lab:authorizedBy"
    assert PROPERTY_IRI_BY_NAME["commitsTo"] == "urn:autofde-lab:commitsTo"
    assert STANDING_VALUE_IRI["ALIVE"] == "urn:autofde-lab:ALIVE"
    assert STANDING_VALUE_IRI["UNSUPPORTED"] == "urn:autofde-lab:UNSUPPORTED"
