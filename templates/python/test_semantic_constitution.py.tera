    for label, iri in STANDING_VALUE_IRI.items():
        assert label
        assert iri == f"urn:autofde-lab:{label}"


def test_direct_python_inheritance_is_closed_over_registry() -> None:
    admitted_classes = set(CLASS_BY_IRI.values())
    for cls in admitted_classes:
        assert len(cls.__bases__) == 1
        base = cls.__bases__[0]
        assert base is SemanticEntity or base in admitted_classes
        assert SemanticEntity in cls.mro()
        assert cls.mro().count(cls) == 1
        assert cls.mro().count(SemanticEntity) == 1


def test_combinatorial_carrier_closure_over_all_admitted_dimensions() -> None:
    combinations = product(
        CLASS_BY_IRI.items(),
        PROPERTY_IRI_BY_NAME.items(),
        STANDING_VALUE_IRI.items(),
    )
    observed = 0
    for (
        (rdf_type, cls),
        (property_name, property_iri),
        (standing_name, standing_iri),
    ) in combinations:
        entity = entity_from_rdf_type(
            rdf_type,
            iri=f"urn:test:combo:{observed}",
            values={
                property_iri: standing_iri,
                "urn:test:property-name": property_name,
                "urn:test:standing-name": standing_name,
            },
        )
        assert type(entity) is cls
        assert entity.get(property_iri) == standing_iri
        assert entity.as_bindings()["@type"] == rdf_type
        observed += 1

    assert observed == (
        EXPECTED_CLASS_COUNT * EXPECTED_PROPERTY_COUNT * EXPECTED_STANDING_COUNT
    )


def test_unknown_rdf_type_is_a_typed_lookup_refusal() -> None:
    unknown = "urn:autofde-lab:NotAdmitted"
    with pytest.raises(KeyError, match="No generated Python projection"):
        class_for_rdf_type(unknown)
    with pytest.raises(KeyError, match="No generated Python projection"):
        entity_from_rdf_type(unknown, iri="urn:test:unknown")


def test_required_property_refusal_identifies_every_subject() -> None:
    property_iri = next(iter(PROPERTY_IRI_BY_NAME.values()))
    for index, rdf_type in enumerate(CLASS_BY_IRI):
        entity = entity_from_rdf_type(rdf_type, iri=f"urn:test:empty:{index}")
        with pytest.raises(KeyError) as exc_info:
            entity.require(property_iri)
        message = str(exc_info.value)
        assert rdf_type in message
        assert property_iri in message
