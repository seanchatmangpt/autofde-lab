def test_registry_is_total_bijective_and_type_exact() -> None:
    assert len(CLASS_BY_IRI) == EXPECTED_CLASS_COUNT
    assert len(set(CLASS_BY_IRI.values())) == EXPECTED_CLASS_COUNT

    for rdf_type, cls in CLASS_BY_IRI.items():
        assert rdf_type.startswith("urn:autofde-lab:")
        assert cls.__name__ == rdf_type.rsplit(":", 1)[-1]
        assert cls.RDF_TYPE == rdf_type
        assert cls.rdf_type() == rdf_type
        assert class_for_rdf_type(rdf_type) is cls
        assert issubclass(cls, SemanticEntity)
        assert cls.__module__.startswith("autofde_lab.constitution.")


def test_every_projected_class_round_trips_immutable_bindings() -> None:
    property_iri = next(iter(PROPERTY_IRI_BY_NAME.values()))

    for index, (rdf_type, cls) in enumerate(CLASS_BY_IRI.items()):
        original = f"value:{index}"
        source = {property_iri: original}
        entity = entity_from_rdf_type(
            rdf_type,
            iri=f"urn:test:entity:{index}",
            values=source,
        )
        source[property_iri] = "mutated-after-construction"

        assert type(entity) is cls
        assert isinstance(entity.values, MappingProxyType)
        assert entity.require(property_iri) == original
        assert entity.get(property_iri) == original
        assert entity.as_bindings() == {
            "@id": f"urn:test:entity:{index}",
            "@type": rdf_type,
            property_iri: original,
        }

        evolved = entity.with_values(**{property_iri: "evolved"})
        assert type(evolved) is cls
        assert evolved.require(property_iri) == "evolved"
        assert entity.require(property_iri) == original


def test_term_projection_is_total_well_formed_and_collision_free() -> None:
    assert len(PROPERTY_IRI_BY_NAME) == EXPECTED_PROPERTY_COUNT
