"""PUBLIC-ONLY ADMISSION policy — generated proof.

Manufactured by `ggen sync run` from `ontology/public-ontology-admission.ttl`
via `queries/public-ontology-admission/admission.rq` -- the SAME query the
generated module itself is built from, so this test can never hardcode a
class/authority count that drifts from the real ontology: every row below
is re-derived fresh on every sync, not typed once and left stale.

GENERATED by ggen. DO NOT EDIT BY HAND -- edit
`ontology/public-ontology-admission.ttl` and re-run `ggen sync run` from the
repo root to regenerate.
"""
from __future__ import annotations

from autofde_lab.semantics.admission import (
    ADMITTED_CLASSES,
    PUBLIC_AUTHORITIES,
    SourceKind,
    classify,
    is_admitted,
)

{% set authority_rows = sparql_results | filter(attribute="rowKind", value="authority") -%}
{% set class_rows = sparql_results | filter(attribute="rowKind", value="class") -%}
ONTOLOGY_AUTHORITY_IDS = [
{% for row in authority_rows -%}
    "{{ row.authorityId }}",
{% endfor -%}
]

ONTOLOGY_ADMITTED_CLASS_IRIS = [
{% for row in class_rows -%}
    "{{ row.classIri }}",
{% endfor -%}
]


def test_every_ontology_authority_is_present_in_the_generated_registry():
    assert set(PUBLIC_AUTHORITIES) == set(ONTOLOGY_AUTHORITY_IDS)


def test_every_ontology_admitted_class_is_recognized():
    for class_iri in ONTOLOGY_ADMITTED_CLASS_IRIS:
        assert is_admitted(class_iri) is True, class_iri


def test_generated_registry_carries_exactly_the_ontologys_own_classes():
    # No hardcoded count: re-derived from the real ontology on every sync,
    # so a new/removed authority or class can never leave a stale literal
    # behind (this is the exact drift the hand-written version of this test
    # once had, caught and fixed 2026-08-12 -- see git history).
    assert set(ADMITTED_CLASSES) == set(ONTOLOGY_ADMITTED_CLASS_IRIS)


def test_a_real_prov_o_class_is_admitted_as_native_ontology():
    assert is_admitted("http://www.w3.org/ns/prov#Entity") is True
    assert classify("http://www.w3.org/ns/prov#Entity") == SourceKind.NATIVE_ONTOLOGY


def test_an_invented_private_class_is_refused():
    """The exact failure mode the admission law exists to prevent: a made-up
    class like `SonyApplication` must never be silently treated as
    admitted."""
    assert is_admitted("http://sony.example/SonyApplication") is False
    assert classify("http://sony.example/SonyApplication") is None
