{
  "_doc": "WS2 authority-classification rules. Ordered: the FIRST matching pattern per command line wins for that line; a multi-line command takes the MAX class over its lines (order: READ < REVERSIBLE_BUILD < NETWORK_FETCH < CONSEQUENTIAL < DESTRUCTIVE); a recipe with dependencies inherits the max over its transitive dependencies. Patterns are Python regexes matched case-sensitively against a single shell line with leading '@', '-', '+' and env assignments stripped.",
  "class_order": ["READ", "REVERSIBLE_BUILD", "NETWORK_FETCH", "CONSEQUENTIAL", "DESTRUCTIVE"],
  "reversibility_by_class": {
    "READ": "IDEMPOTENT",
    "REVERSIBLE_BUILD": "REVERSIBLE",
    "NETWORK_FETCH": "REVERSIBLE",
    "CONSEQUENTIAL": "IRREVERSIBLE",
    "DESTRUCTIVE": "IRREVERSIBLE"
  },
  "qualification_by_class": {
    "READ": "run-and-capture: execute with timeout, assert exit 0, snapshot stdout; safe to auto-run",
    "REVERSIBLE_BUILD": "worktree-run: execute in an isolated worktree copy, assert exit 0 and declared artifact paths exist, rerun to check idempotence, diff tracked files == empty",
    "NETWORK_FETCH": "sandbox-fetch: execute with network permitted once, hash resulting lockfile/deps dir, assert exit 0; cache result, do not re-run per qualification",
    "CONSEQUENTIAL": "dry-run-only: run the dry-run/plan variant if one exists; the real command requires an AuthorityDecision object in the OCEL log before ActionStarted",
    "DESTRUCTIVE": "never-auto-run: simulate on a throwaway copy only; real execution requires an explicit AuthorityGranted event naming this capability id"
  },
  "rules": [
    {"class": "DESTRUCTIVE", "pattern": "\\brm\\s+(-[a-zA-Z]*r[a-zA-Z]*|--recursive)\\b", "effect": "recursively deletes filesystem paths", "reversibility": "IRREVERSIBLE"},
    {"class": "DESTRUCTIVE", "pattern": "\\bgit\\s+reset\\s+--hard\\b", "effect": "discards working tree and index state", "reversibility": "IRREVERSIBLE"},
    {"class": "DESTRUCTIVE", "pattern": "\\bgit\\s+clean\\b", "effect": "deletes untracked files", "reversibility": "IRREVERSIBLE"},
    {"class": "DESTRUCTIVE", "pattern": "\\bgit\\s+push\\b.*(--force|-f\\b|\\+[a-zA-Z])", "effect": "rewrites remote branch history", "reversibility": "IRREVERSIBLE"},
    {"class": "DESTRUCTIVE", "pattern": "\\bgit\\s+branch\\s+-D\\b", "effect": "force-deletes a local branch", "reversibility": "IRREVERSIBLE"},
    {"class": "DESTRUCTIVE", "pattern": "\\bterraform\\s+destroy\\b", "effect": "destroys cloud resources", "reversibility": "IRREVERSIBLE"},
    {"class": "DESTRUCTIVE", "pattern": "\\bdocker\\s+(system|image|container|volume)\\s+prune\\b", "effect": "deletes docker images/containers/volumes", "reversibility": "IRREVERSIBLE"},
    {"class": "DESTRUCTIVE", "pattern": "\\b(DROP|TRUNCATE)\\s+(TABLE|DATABASE)\\b", "effect": "drops database objects", "reversibility": "IRREVERSIBLE"},
    {"class": "DESTRUCTIVE", "pattern": "\\bkubectl\\s+delete\\b", "effect": "deletes kubernetes resources", "reversibility": "IRREVERSIBLE"},
    {"class": "CONSEQUENTIAL", "pattern": "\\bgit\\s+push\\b", "effect": "mutates a remote repository", "reversibility": "IRREVERSIBLE"},
    {"class": "CONSEQUENTIAL", "pattern": "\\bgit\\s+(commit|merge|rebase|tag|checkout|switch)\\b", "effect": "mutates local git history/HEAD", "reversibility": "REVERSIBLE"},
    {"class": "CONSEQUENTIAL", "pattern": "\\brm\\s", "effect": "deletes a named file", "reversibility": "IRREVERSIBLE"},
    {"class": "CONSEQUENTIAL", "pattern": "\\bterraform\\s+(apply|import|taint)\\b", "effect": "mutates cloud resources", "reversibility": "IRREVERSIBLE"},
    {"class": "CONSEQUENTIAL", "pattern": "\\b(docker|podman)\\s+push\\b", "effect": "publishes a container image", "reversibility": "IRREVERSIBLE"},
    {"class": "CONSEQUENTIAL", "pattern": "\\b(cargo|npm|yarn|pnpm|gem|twine|uv)\\s+publish\\b", "effect": "publishes a package to a registry", "reversibility": "IRREVERSIBLE"},
    {"class": "CONSEQUENTIAL", "pattern": "\\bmix\\s+hex\\.publish\\b", "effect": "publishes a hex package", "reversibility": "IRREVERSIBLE"},
    {"class": "CONSEQUENTIAL", "pattern": "\\bgh\\s+(pr|release|issue|workflow\\s+run|repo)\\b", "effect": "mutates GitHub state", "reversibility": "IRREVERSIBLE"},
    {"class": "CONSEQUENTIAL", "pattern": "\\bkubectl\\s+(apply|create|patch|rollout|scale)\\b", "effect": "mutates kubernetes resources", "reversibility": "REVERSIBLE"},
    {"class": "CONSEQUENTIAL", "pattern": "\\b(gcloud|az|aws)\\s+\\S+.*\\b(deploy|create|update|delete|run)\\b", "effect": "mutates cloud resources", "reversibility": "IRREVERSIBLE"},
    {"class": "CONSEQUENTIAL", "pattern": "\\bdocker\\s+compose\\b.*\\b(up|down|rm)\\b", "effect": "starts/stops containers", "reversibility": "REVERSIBLE"},
    {"class": "CONSEQUENTIAL", "pattern": "\\bggen\\s+sync\\s+run\\b(?!.*--dry-run)", "effect": "regenerates manufactured source files in the working tree", "reversibility": "REVERSIBLE"},
    {"class": "CONSEQUENTIAL", "pattern": "\\b(sudo|chmod|chown)\\b", "effect": "changes system/permission state", "reversibility": "IRREVERSIBLE"},
    {"class": "NETWORK_FETCH", "pattern": "\\bmix\\s+deps\\.get\\b", "effect": "writes deps/ and mix.lock", "reversibility": "REVERSIBLE"},
    {"class": "NETWORK_FETCH", "pattern": "\\bmix\\s+(local\\.hex|local\\.rebar|hex\\.)", "effect": "installs mix archives", "reversibility": "REVERSIBLE"},
    {"class": "NETWORK_FETCH", "pattern": "\\bgit\\s+(submodule\\s+update|fetch|pull|clone)\\b", "effect": "fetches git objects into the working tree", "reversibility": "REVERSIBLE"},
    {"class": "NETWORK_FETCH", "pattern": "\\b(pip|pip3|pipx)\\s+install\\b", "effect": "installs python packages", "reversibility": "REVERSIBLE"},
    {"class": "NETWORK_FETCH", "pattern": "\\buv\\s+(sync|pip\\s+install|add|lock|tool\\s+install)\\b", "effect": "resolves/installs python packages", "reversibility": "REVERSIBLE"},
    {"class": "NETWORK_FETCH", "pattern": "\\b(npm|yarn|pnpm)\\s+(install|ci|add)\\b", "effect": "writes node_modules/", "reversibility": "REVERSIBLE"},
    {"class": "NETWORK_FETCH", "pattern": "\\bcargo\\s+(fetch|install|update)\\b", "effect": "fetches crates", "reversibility": "REVERSIBLE"},
    {"class": "NETWORK_FETCH", "pattern": "\\brebar3\\s+(get-deps|update|upgrade)\\b", "effect": "fetches rebar deps", "reversibility": "REVERSIBLE"},
    {"class": "NETWORK_FETCH", "pattern": "\\b(curl|wget)\\b", "effect": "network I/O", "reversibility": "UNKNOWN"},
    {"class": "NETWORK_FETCH", "pattern": "\\b(docker|podman)\\s+(pull|build)\\b", "effect": "pulls base image layers and writes an image", "reversibility": "REVERSIBLE"},
    {"class": "NETWORK_FETCH", "pattern": "\\bterraform\\s+init\\b", "effect": "downloads providers into .terraform/", "reversibility": "REVERSIBLE"},
    {"class": "NETWORK_FETCH", "pattern": "\\b(gleam)\\s+(deps\\s+download|add)\\b", "effect": "fetches gleam deps", "reversibility": "REVERSIBLE"},
    {"class": "READ", "pattern": "\\bjust\\s+--(list|summary|show|dump)\\b", "effect": "", "reversibility": "IDEMPOTENT"},
    {"class": "READ", "pattern": "--help\\b|\\s-h\\b|--version\\b", "effect": "", "reversibility": "IDEMPOTENT"},
    {"class": "READ", "pattern": "\\bterraform\\s+(validate|fmt\\s+-check|fmt\\s+--check|show|output)\\b", "effect": "", "reversibility": "IDEMPOTENT"},
    {"class": "READ", "pattern": "\\bterraform\\s+plan\\b", "effect": "reads cloud state (needs credentials), writes nothing", "reversibility": "IDEMPOTENT"},
    {"class": "READ", "pattern": "\\bgit\\s+(status|log|diff|show|rev-parse|ls-files|branch\\s*$|remote\\s+-v)\\b", "effect": "", "reversibility": "IDEMPOTENT"},
    {"class": "READ", "pattern": "^(ls|cat|echo|printf|head|tail|wc|grep|find|test|\\[|true|pwd|which|date|env|export)\\b", "effect": "", "reversibility": "IDEMPOTENT"},
    {"class": "READ", "pattern": "\\bggen\\s+sync\\s+run\\b.*--dry-run", "effect": "", "reversibility": "IDEMPOTENT"},
    {"class": "READ", "pattern": "\\b(cargo|mix|rebar3|ruff|black|eslint|prettier)\\s+(fmt|format|clippy|check|credo|dialyzer|xref)\\b", "effect": "may rewrite source formatting", "reversibility": "REVERSIBLE"},
    {"class": "READ", "pattern": "\\b(ruff|flake8|mypy|pyright|shellcheck|pre-commit|yamllint|hadolint)\\b", "effect": "", "reversibility": "IDEMPOTENT"},
    {"class": "REVERSIBLE_BUILD", "pattern": "\\bcargo\\s+(build|test|bench|doc|run)\\b", "effect": "writes target/", "reversibility": "REVERSIBLE"},
    {"class": "REVERSIBLE_BUILD", "pattern": "\\bmix\\s+(compile|test|escript\\.build|release|docs)\\b", "effect": "writes _build/", "reversibility": "REVERSIBLE"},
    {"class": "REVERSIBLE_BUILD", "pattern": "\\bmix\\s+\\S+", "effect": "runs a mix task (writes _build/ if it compiles)", "reversibility": "REVERSIBLE"},
    {"class": "REVERSIBLE_BUILD", "pattern": "\\brebar3\\s+(compile|eunit|ct|as\\s+\\S+|release|escriptize)\\b", "effect": "writes _build/", "reversibility": "REVERSIBLE"},
    {"class": "REVERSIBLE_BUILD", "pattern": "\\bgleam\\s+(build|test|check)\\b", "effect": "writes build/", "reversibility": "REVERSIBLE"},
    {"class": "REVERSIBLE_BUILD", "pattern": "\\b(pytest|python3?\\s+-m\\s+pytest)\\b", "effect": "writes .pytest_cache/", "reversibility": "REVERSIBLE"},
    {"class": "REVERSIBLE_BUILD", "pattern": "\\buv\\s+run\\b", "effect": "runs a python entrypoint in the uv env (may write repo-local outputs)", "reversibility": "REVERSIBLE"},
    {"class": "REVERSIBLE_BUILD", "pattern": "\\b(npm|yarn|pnpm)\\s+(run|test|build)\\b", "effect": "writes build outputs", "reversibility": "REVERSIBLE"},
    {"class": "REVERSIBLE_BUILD", "pattern": "\\b(make|just|task|cmake|ninja|maturin|wasm-pack)\\b", "effect": "delegates to a build tool", "reversibility": "REVERSIBLE"},
    {"class": "REVERSIBLE_BUILD", "pattern": "\\b(python3?|bash|sh|node|elixir|erl|escript)\\s+\\S+", "effect": "runs a repo script (effects opaque without reading the script)", "reversibility": "UNKNOWN"},
    {"class": "REVERSIBLE_BUILD", "pattern": "\\bcd\\s+\\S+", "effect": "", "reversibility": "IDEMPOTENT"}
  ],
  "default": {"class": "REVERSIBLE_BUILD", "effect": "unclassified command line (UNVERIFIED)", "reversibility": "UNKNOWN"}
}
