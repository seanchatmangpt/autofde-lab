PREFIX ocel: <https://crown2.local/ocel#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
# Returns ?ev = violating event IRI (urn:ev:<id>)
SELECT DISTINCT ?ev WHERE {
  ?ev ocel:eventType "PlannerInvoked" ; ocel:time ?t .
  FILTER NOT EXISTS {
    ?ev ocel:relates ?o . ?term ocel:relates ?o ; ocel:eventType ?tt ; ocel:time ?t2 .
    FILTER(?tt IN ("PlanProduced","PlanRefused") && ?t2 >= ?t && ?term != ?ev)
  }
}
