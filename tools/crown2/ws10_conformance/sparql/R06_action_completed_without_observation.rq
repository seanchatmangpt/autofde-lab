PREFIX ocel: <https://crown2.local/ocel#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
# Returns ?ev = violating event IRI (urn:ev:<id>)
SELECT DISTINCT ?ev WHERE {
  ?ev ocel:eventType "ActionCompleted" ; ocel:time ?t ; ocel:episode ?ep .
  FILTER NOT EXISTS {
    ?obs ocel:eventType ?ot ; ocel:episode ?ep ; ocel:time ?t2 .
    FILTER(?ot IN ("WorldStateObserved","QualificationObserved") && ?t2 >= ?t && ?obs != ?ev)
  }
}
