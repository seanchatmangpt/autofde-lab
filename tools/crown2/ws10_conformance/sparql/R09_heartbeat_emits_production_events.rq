PREFIX ocel: <https://crown2.local/ocel#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
# Returns ?ev = violating event IRI (urn:ev:<id>)
SELECT DISTINCT ?ev WHERE {
  ?ev ocel:eventType ?et ; ocel:relates ?ep .
  ?ep ocel:objectType "ProcessEpisode" ; ocel:attr_label ?label .
  FILTER(STRSTARTS(?label, "heartbeat"))
  FILTER(?et IN ("PlannerInvoked","PlanProduced","PlanRefused","PredictionFrozen",
                 "AuthorityEvaluated","AuthorityGranted","AuthorityRefused",
                 "ActionStarted","ActionCompleted","ActionFailed","ActionRefused",
                 "QualificationObserved","PredictionCompared"))
}
