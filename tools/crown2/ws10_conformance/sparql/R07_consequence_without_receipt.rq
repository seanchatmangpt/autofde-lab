PREFIX ocel: <https://crown2.local/ocel#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
# Returns ?ev = violating event IRI (urn:ev:<id>)
SELECT DISTINCT ?ev WHERE {
  ?ev ocel:eventType ?et ; ocel:time ?t ; ocel:episode ?ep .
  FILTER(?et IN ("ActionCompleted","ActionFailed","QualificationObserved"))
  FILTER NOT EXISTS {
    ?r ocel:eventType "ReceiptIssued" ; ocel:episode ?ep ; ocel:time ?t2 . FILTER(?t2 >= ?t)
  }
}
