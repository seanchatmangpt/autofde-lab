PREFIX ocel: <https://crown2.local/ocel#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
# Returns ?ev = violating event IRI (urn:ev:<id>)
SELECT DISTINCT ?ev WHERE {
  ?ev ocel:eventType "PlanProduced" ; ocel:time ?t .
  FILTER NOT EXISTS {
    ?ev ocel:relates ?o . ?pf ocel:relates ?o ; ocel:eventType "PredictionFrozen" ; ocel:time ?t2 .
    FILTER(?t2 >= ?t)
  }
}
