  sjira:desiredConsequence "An admitted Oracle/NOP/mutation court projects to a powerless SA2A Candidate and compiles only to CANDIDATE MachineExperience." ;
  sjira:acceptancePredicate "Oracle success is required." ;
  sjira:acceptancePredicate "A successful no-op is refused." ;
  sjira:acceptancePredicate "Any surviving known-wrong mutation is refused." ;
  sjira:acceptancePredicate "The candidate has authority=none and grants_do_authority=false." ;
  sjira:acceptancePredicate "Experience compilation stops at CANDIDATE; it does not become ACTIVE or acquire a known route." ;
  sjira:falsifier "A failed oracle, successful no-op, surviving mutation, or DO authority produces an admitted court." ;
  sjira:falsifier "Court compilation creates ACTIVE MachineExperience or a known route without independent qualification." ;
